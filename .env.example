# Copied to .env by scripts/setup.sh. Never commit .env.
HOST_UID=1000
HOST_GID=1000
# DVC remote storage on the VM (setup.sh sets it to ~/dvc-store)
DVC_REMOTE_DIR=./.dvc-remote
LOG_LEVEL=INFO
MODEL_NAME=acepredict
ADMIN_API_KEY=change-me-admin-key
# Must match the bearer token in monitoring/alertmanager/alertmanager.yml
WEBHOOK_TOKEN=change-me-webhook-token
MONITOR_INTERVAL_S=15
LIVE_WINDOW=200
DRIFT_MIN_SAMPLES=50
AUTO_RETRAIN_COOLDOWN_S=1800
# URLs your browser uses (links and embedded dashboards in the UI)
GRAFANA_PUBLIC_URL=http://localhost:3000
MLFLOW_PUBLIC_URL=http://localhost:5000
PROMETHEUS_PUBLIC_URL=http://localhost:9090
RAY_PUBLIC_URL=http://localhost:8265
GRAFANA_ADMIN_PASSWORD=admin
