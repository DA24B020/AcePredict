# Binary files go to Git LFS (images in docs, the saved architecture diagram, PDFs)
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.svg filter=lfs diff=lfs merge=lfs -text
# Shell scripts must keep LF endings even if the repo is opened on Windows
*.sh text eol=lf
